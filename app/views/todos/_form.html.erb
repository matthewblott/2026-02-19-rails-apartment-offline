<!-- app/views/todos/_form.html.erb -->
<%= form_with(model: todo, url: todo.persisted? ? user_todo_update_path(Current.user, todo) : user_todos_create_path(Current.user), method: todo.persisted? ? :patch : :post) do |form| %>
  <% if todo.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(todo.errors.count, "error") %> prohibited this todo from being saved:</h2>
      <ul>
        <% todo.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Hidden field for client-generated UUID on create %>
  <% if todo.new_record? %>
    <%= form.hidden_field :id, value: "", data: { uuid_field: true } %>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :details, style: "display: block" %>
    <%= form.text_area :details %>
  </div>

  <div>
    <%= form.label :completed, style: "display: block" %>
    <%= form.check_box :completed %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>

<script>
  // Generate UUID for new records
  document.addEventListener('turbo:load', () => {
    const uuidField = document.querySelector('[data-uuid-field]')
    if (uuidField && !uuidField.value) {
      uuidField.value = crypto.randomUUID()
    }
  })
</script>
